<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kompiliert Core, Simulation und Application (ohne Unity/) gegen netstandard2.1 = API-Umfang von Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WorldBeyond.Headless</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="../../../../Assets/_Project/Scripts/Simulation/**/*.cs" />
    <Compile Include="../../../../Assets/_Project/Scripts/Application/**/*.cs" Exclude="../../../../Assets/_Project/Scripts/Application/Unity/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gleiche Hauptversion wie com.unity.nuget.newtonsoft-json 3.2.x (Newtonsoft.Json 13.0.2) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
