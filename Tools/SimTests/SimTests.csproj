<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Prüft die Unity-unabhängigen Teile (Core, Simulation, Application ohne Unity/) und die EditMode-Tests
    mit dem .NET SDK, ohne Unity-Editor. Ersetzt nicht den Unity Test Runner (TEST_PLAN §2).
    Aufruf: dotnet test Tools/SimTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WorldBeyond.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Application/**/*.cs" Exclude="../../Assets/_Project/Scripts/Application/Unity/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <!-- Gleiche Hauptversion wie com.unity.nuget.newtonsoft-json; für Application/Save (Phase 7) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
